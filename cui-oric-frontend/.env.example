# Backend API prefix. The app runs on http://localhost:3000 by default so it matches the backend's default CORS setting.
VITE_API_BASE_URL=http://localhost:5000/api/v1
# Keep these aligned with FACULTY_EMAIL_DOMAIN and STUDENT_EMAIL_DOMAIN on the backend deployment.
VITE_FACULTY_EMAIL_DOMAIN=cuisahiwal.edu.pk
VITE_STUDENT_EMAIL_DOMAIN=students.cuisahiwal.edu.pk
