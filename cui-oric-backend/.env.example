# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/cui-oric

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email Domain Restriction (role-based)
FACULTY_EMAIL_DOMAIN=cuisahiwal.edu.pk
STUDENT_EMAIL_DOMAIN=students.cuisahiwal.edu.pk

# Email/SMTP Configuration
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM=noreply@cui-oric.com
EMAIL_FROM_NAME=CUI ORIC

# AWS S3 & CloudFront
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=cui-oric-publications
AWS_CLOUDFRONT_DOMAIN=xxxxxxxx.cloudfront.net

# File Upload Limits
MAX_PDF_SIZE_MB=20

# CORS
CORS_ORIGIN=http://localhost:3000

# Optional: LanguageTool API for grammar/plagiarism (set to enable)
LANGUAGETOOL_API_URL=https://api.languagetool.org/v2
LANGUAGETOOL_API_KEY=